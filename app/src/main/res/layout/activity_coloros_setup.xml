<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Make your phone leave Tether alone"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ColorOS (Oppo) kills apps running in the background. If you skip these, Tether will be killed mid-session and your internet will just stop — the exact thing NetShare did. Do all three, in order."
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/step1_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="1. Battery: Unrestricted"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap the button, then on the app page tap Battery usage and choose Unrestricted (NOT Optimised)."
            android:textSize="15sp" />

        <Button
            android:id="@+id/step1_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open app settings" />

        <CheckBox
            android:id="@+id/step2_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="2. Auto-launch: ON"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="On the same app page, find Auto-launch (or Auto start) and switch it ON. Without this, Tether cannot restart itself after the phone kills it."
            android:textSize="15sp" />

        <Button
            android:id="@+id/step2_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open app settings" />

        <CheckBox
            android:id="@+id/step3_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="3. Lock Tether in Recents"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open the Recents screen (the square button at the bottom), find Tether, pull its card down and tap the lock icon. This stops 'Clear all' from killing it."
            android:textSize="15sp" />

        <Button
            android:id="@+id/step3_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="How to do it" />

        <TextView
            android:id="@+id/hint_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tick each box as you finish it. All three are needed."
            android:textSize="15sp" />

        <Button
            android:id="@+id/done_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="Done — start sharing"
            android:textSize="17sp" />

    </LinearLayout>
</ScrollView>
